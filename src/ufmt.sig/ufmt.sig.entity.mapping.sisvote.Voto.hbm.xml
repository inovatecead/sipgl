<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.sisvote"
                   assembly="ufmt.sig" auto-import="false">

  <class name="Voto" table="sisvote.Voto">

    <id name="VotoUID">
      <column name="votoUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Cargo" lazy="false">
      <column name="cargoUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="Candidato" lazy="false">
      <column name="candidatoUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

    <many-to-one name="Servidor" lazy="false">
      <column name="servidorUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="TipoVoto" lazy="false">
      <column name="tipoVotoUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="DataHora">
      <column name="dataHora" sql-type="datetime" not-null="true"/>
    </property>

    <property name="Ip">
      <column name="ip" sql-type="varchar(39)" not-null="true"/>
    </property>

  </class>

</hibernate-mapping>