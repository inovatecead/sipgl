<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Aplicacao" table="Aplicacao">

    <id name="AplicacaoUID">
      <column name="aplicacaoUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(2048)" not-null="false"/>
    </property>

    <property name="Icone">
      <column name="icone" sql-type="varbinary(8000)" not-null="false"/>
    </property>

    <property name="Url">
      <column name="url" sql-type="varchar(255)" not-null="false"/>
    </property>

    <property name="Sigla">
      <column name="sigla" sql-type="char(10)" not-null="false"/>
    </property>

    <property name="Situacao">
      <column name="situacao" sql-type="varchar(255)" not-null="false"/>
    </property>

    <property name="Plataforma">
      <column name="plataforma" sql-type="varchar(255)" not-null="false"/>
    </property>

    <property name="SistemaOperacional">
      <column name="sistemaOperacional" sql-type="varchar(255)" not-null="false"/>
    </property>

    <property name="Sgbd">
      <column name="sgbd" sql-type="varchar(255)" not-null="false"/>
    </property>

    <property name="RequisitosMinimos">
      <column name="requisitosMinimos" sql-type="varchar(255)" not-null="false"/>
    </property>

    <property name="Versao">
      <column name="versao" sql-type="varchar(50)" not-null="false"/>
    </property>

    <property name="Objetivo">
      <column name="objetivo" sql-type="varchar(2048)" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>