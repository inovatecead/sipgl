<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.cineclube"
                   assembly="ufmt.sig" auto-import="false">

  <class name="Genero" table="cineclube.Genero">

    <id name="GeneroUID">
      <column name="generoUID" sql-type="int" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(200)" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>