<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Servidor" table="Servidor">

    <id name="ServidorUID">
      <column name="servidorUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Pessoa" lazy="false">
      <column name="pessoaUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="Registro">
      <column name="registro" sql-type="varchar(30)" not-null="true"/>
    </property>

    <property name="RegistroDV">
      <column name="registroDV" sql-type="char(1)" not-null="true"/>
    </property>

    <property name="TipoRegistro">
      <column name="tipoRegistro" sql-type="char(1)" not-null="true"/>
    </property>

    <property name="RegimeJuridico">
      <column name="regimeJuridico" sql-type="varchar(3)" not-null="true"/>
    </property>

    <many-to-one name="JornadaTrabalho" lazy="false">
      <column name="jornadaTrabalhoUID" sql-type="int" not-null="true"/>
    </many-to-one>

    <many-to-one name="Cargo" lazy="false">
      <column name="cargoUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="CargoClasse">
      <column name="cargoClasse" sql-type="char(1)" not-null="false"/>
    </property>

    <property name="CargoReferenciaNivelPadrao">
      <column name="cargoReferenciaNivelPadrao" sql-type="varchar(3)" not-null="false"/>
    </property>

    <many-to-one name="UnidadeLotacao" lazy="false">
      <column name="unidadeLotacaoUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

    <property name="AposentadoriaNumeroProcesso">
      <column name="aposentadoriaNumeroProcesso" sql-type="varchar(30)" not-null="false"/>
    </property>
   
    <property name="AposentadoriaAnoPrevisto">
      <column name="aposentadoriaAnoPrevisto" sql-type="int" not-null="false"/>
    </property>
    
    <property name="AposentadoriaOpcaoIntegral">
      <column name="aposentadoriaOpcaoIntegral" sql-type="char(1)" not-null="false"/>
    </property>

    <many-to-one name="SituacaoServidor" lazy="false">
      <column name="situacaoServidorUID" sql-type="int" not-null="true"/>
    </many-to-one>
    
  </class>

</hibernate-mapping>