<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.progressaofuncional"
                   assembly="ufmt.sig" auto-import="false">

  <class name="Item" table="pFuncional.Item">

    <id name="Id">
      <column name="Id" sql-type="int" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="SubCategoria" lazy="false"  insert="false"  update="false">
      <column name="SubCategoriaId" sql-type="int" not-null="true"/>
    </many-to-one>

    <many-to-one name="Metrica" lazy="false"  insert="false"  update="false">
      <column name="MetricaId" sql-type="int" not-null="true"/>
    </many-to-one>
    
    
    <bag name="ItemToCampos" lazy="true" inverse="true" >
      <key column="ItemId" />
      <one-to-many class="ItemToCampos" />

    </bag>

    <property name="MetricaId">
      <column name="MetricaId" sql-type="varchar(max)" not-null="true"/>
    </property>

    <property name="SubCategoriaId">
      <column name="SubCategoriaId" sql-type="varchar(max)" not-null="true"/>
    </property>
    
    <property name="Descricao">
      <column name="Descricao" sql-type="varchar(max)" not-null="true"/>
    </property>

    <property name="Passo">
      <column name="Passo" sql-type="int" not-null="true"/>
    </property>

    <property name="Pontos">
      <column name="Pontos" sql-type="float" not-null="true"/>
    </property>
  </class>

</hibernate-mapping>