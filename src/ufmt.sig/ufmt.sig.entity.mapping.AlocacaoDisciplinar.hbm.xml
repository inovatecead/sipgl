<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="AlocacaoDisciplinar" table="AlocacaoDisciplinar">

    <id name="AlocacaoDisciplinarUID">
      <column name="alocacaoDisciplinarUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="AlocacaoDisciplinarPrincipal" lazy="false">
      <column name="alocacaoDisciplinarPrincipalUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

    <many-to-one name="MatrizDisciplinar" lazy="false">
      <column name="matrizDisciplinarUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="ServidorDocente" lazy="false">
      <column name="servidorDocenteUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

    <property name="Ano">
      <column name="ano" sql-type="int" not-null="false"/>
    </property>

    <property name="Periodo">
      <column name="periodo" sql-type="int" not-null="false"/>
    </property>

    <property name="TipoAlocacaoDisciplinarUID">
      <column name="tipoAlocacaoDisciplinarUID" sql-type="int" not-null="false"/>
    </property>

    <property name="QuantidadeOrientandos">
      <column name="quantidadeOrientandos" sql-type="int" not-null="false"/>
    </property>

    <property name="CargaHoraria">
      <column name="cargaHoraria" sql-type="numeric(7,2)" not-null="true"/>
    </property>

    <property name="CargaHorariaSemanal">
      <column name="cargaHorariaSemanal" sql-type="numeric(7,2)" not-null="true"/>
    </property>

    <property name="CoeficientePreparacaoAula">
      <column name="coeficientePreparacaoAula" sql-type="numeric(7,2)" not-null="false"/>
    </property>

    <property name="Fracionada">
      <column name="fracionada" sql-type="bit" not-null="true"/>
    </property>

    <property name="TipoFracionamentoDisciplinarUID">
      <column name="tipoFracionamentoDisciplinarUID" sql-type="int" not-null="false"/>
    </property>

    <property name="Identificacao">
      <column name="identificacao" sql-type="varchar(10)" not-null="false"/>
    </property>

    <property name="JustificativaFracionamento">
      <column name="justificativaFracionamento" sql-type="varchar(512)" not-null="false"/>
    </property>

    <property name="IsCoordenadorFracionou">
      <column name="isCoordenadorFracionou" sql-type="bit" not-null="true"/>
    </property>

    <many-to-one name="ServidorFracionador" lazy="false">
      <column name="servidorFracionadorUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

  </class>

</hibernate-mapping>