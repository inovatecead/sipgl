<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
									 namespace="ufmt.sig.entity.progressaofuncional"
									 assembly="ufmt.sig" auto-import="false">

	<class name="ProgressaoFuncional" table="pFuncional.ProgressaoFuncional" lazy="false">


		<id name="Id">
			<column name="Id" sql-type="int" not-null="true"/>
			<generator class="identity"/>
		</id>

		<bag name="ProgressaoFuncionalToItems"   lazy="false" inverse="true">
			<key column="ProgressaoFuncionalId" />
			<one-to-many class="ProgressaoFuncionalToItem"   />

		</bag>
		<bag name="Ocorrencias"   lazy="false" inverse="true">
			<key column="ProgressaoFuncionalID" />
			<one-to-many class="Ocorrencia"   />
		</bag>
		<property name="periodo">
			<column name="periodo" sql-type="nvarchar(max)" not-null="false"/>
		</property>

		<property name="situacao">
			<column name="situacao" sql-type="nchar(100)" not-null="false"/>
		</property>

		<property name="dataEnvio">
			<column name="dataEnvio" sql-type="datetime" not-null="false"/>
		</property>

		<property name="dataCriacao">
			<column name="dataCriacao" sql-type="datetime" not-null="false"/>
		</property>

    <property name="dataAprovacao">
      <column name="dataAprovacao" sql-type="datetime" not-null="false"/>
    </property>
    
		<property name="PessoaUID">
			<column name="PessoaUID" sql-type="int" not-null="true"/>
		</property>
		
		<many-to-one name="Pessoa" lazy="false"  insert="false" update="false">
			<column name="PessoaUID" sql-type="int" not-null="true"/>
		</many-to-one>
		
	</class>

</hibernate-mapping>