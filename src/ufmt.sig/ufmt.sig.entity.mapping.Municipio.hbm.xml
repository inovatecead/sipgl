<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Municipio" table="Municipio">

    <id name="MunicipioUID">
      <column name="municipioUID" sql-type="int" not-null="true"/>
    </id>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <many-to-one name="Uf" lazy="false">
      <column name="uf" sql-type="varchar(2)" not-null="true"/>
    </many-to-one>

  </class>
</hibernate-mapping>