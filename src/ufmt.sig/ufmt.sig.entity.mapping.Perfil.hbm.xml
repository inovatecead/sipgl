<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Perfil" table="Perfil">

    <id name="PerfilUID">
      <column name="perfilUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(2048)" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>