<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="MatrizDisciplinar" table="MatrizDisciplinar">

    <id name="MatrizDisciplinarUID">
      <column name="matrizDisciplinarUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="MatrizCurricular" lazy="false">
      <column name="matrizCurricularUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="PeriodoInicialFuncionamento">
      <column name="periodoInicialFuncionamento" sql-type="int" not-null="false"/>
    </property>

    <property name="PeriodoFinalFuncionamento">
      <column name="periodoFinalFuncionamento" sql-type="int" not-null="false"/>
    </property>

    <property name="PeriodoRegularAlocacao">
      <column name="periodoRegularAlocacao" sql-type="int" not-null="true"/>
    </property>

    <property name="PeriodoRegularCurso">
      <column name="periodoRegularCurso" sql-type="int" not-null="true"/>
    </property>

    <property name="TipoOfertaDisciplinarUID">
      <column name="tipoOfertaDisciplinarUID" sql-type="int" not-null="false"/>
    </property>

    <property name="CodigoExterno">
      <column name="codigoExterno" sql-type="bigint" not-null="true"/>
    </property>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="CargaHorariaTeorica">
      <column name="cargaHorariaTeorica" sql-type="numeric(7,2)" not-null="true"/>
    </property>

    <property name="CargaHorariaPratica">
      <column name="cargaHorariaPratica" sql-type="numeric(7,2)" not-null="true"/>
    </property>

    <property name="CargaHorariaPraticaComponente">
      <column name="cargaHorariaPraticaComponente" sql-type="numeric(7,2)" not-null="true"/>
    </property>

    <property name="Ementa">
      <column name="ementa" sql-type="text" not-null="false"/>
    </property>

    <property name="TipoDisciplinaUID">
      <column name="tipoDisciplinaUID" sql-type="int" not-null="true"/>
    </property>

    <many-to-one name="UnidadeOfertante" lazy="false">
      <column name="unidadeOfertanteUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

  </class>

</hibernate-mapping>