<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.sisvote"
                   assembly="ufmt.sig" auto-import="false">

  <class name="Cargo" table="sisvote.Cargo">

    <id name="CargoUID">
      <column name="cargoUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Eleicao" lazy="false">
      <column name="eleicaoUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="Unidade" lazy="false">
      <column name="unidadeUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(255)" not-null="true"/>
    </property>

  </class>

</hibernate-mapping>