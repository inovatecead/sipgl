<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.progressaofuncional"
                   assembly="ufmt.sig" auto-import="false">

  <class name="Campos" table="pFuncional.Campos">

    <id name="Id">
      <column name="Id" sql-type="int" not-null="true"/>
      <generator class="assigned"/>
    </id>
    <property name="Tipo">
      <column name="Tipo" sql-type="int" not-null="true"/>
    </property>

    <property name="NomeCampo">
      <column name="NomeCampo" sql-type="nvarchar(max)" not-null="true"/>
    </property>

    <property name="Tamanho">
      <column name="Tamanho" sql-type="nvarchar(max)" not-null="true"/>
    </property>
   
  </class>

</hibernate-mapping>