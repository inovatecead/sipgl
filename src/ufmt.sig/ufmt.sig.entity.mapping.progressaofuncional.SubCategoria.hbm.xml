<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.progressaofuncional"
                   assembly="ufmt.sig" auto-import="false">

  <class name="SubCategoria" table="pFuncional.SubCategoria">

    <id name="Id">
      <column name="Id" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Categoria" lazy="false"  insert="false"  update="false">
      <column name="categoriaId" sql-type="int" not-null="true"/>
    </many-to-one>

    <property name="CategoriaId">
      <column name="categoriaId" sql-type="nvarchar(max)" not-null="false"/>
    </property>

    <property name="Descricao">
      <column name="descricao" sql-type="nvarchar(max)" not-null="false"/>
    </property>

    <property name="Nome">
      <column name="Nome" sql-type="nvarchar(max)" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>