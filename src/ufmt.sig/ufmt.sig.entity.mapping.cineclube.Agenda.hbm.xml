<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.cineclube"
                   assembly="ufmt.sig" auto-import="false">

  <class name="Agenda" table="cineclube.Agenda">

    <id name="AgendaUID">
      <column name="agendaUID" sql-type="int" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Filme" lazy="false">
      <column name="filmeUID" sql-type="int" not-null="false"/>
    </many-to-one>

    <property name="Data">
      <column name="data" sql-type="smalldatetime" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>