<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Uf" table="Uf">

    <id name="UfUID">
      <column name="ufUID" sql-type="varchar(2)" not-null="true"/>
    </id>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="CodigoExterno">
      <column name="codigoExterno" sql-type="tinyint" not-null="true"/>
    </property>

  </class>
</hibernate-mapping>