<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="PerfilUsuario" table="PerfilUsuario">

    <id name="PerfilUsuarioUID">
      <column name="perfilUsuarioUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Perfil" lazy="false">
      <column name="perfilUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="Usuario" lazy="false">
      <column name="usuarioUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

  </class>
</hibernate-mapping>