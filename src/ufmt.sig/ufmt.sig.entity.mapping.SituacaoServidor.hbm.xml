<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="SituacaoServidor" table="SituacaoServidor">

    <id name="SituacaoServidorUID">
      <column name="situacaoServidorUID" sql-type="int" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(50)" not-null="true"/>
    </property>

    <property name="SituacaoSiape">
      <column name="situacaoSiape" sql-type="int" not-null="false"/>
    </property>

  </class>
  
</hibernate-mapping>