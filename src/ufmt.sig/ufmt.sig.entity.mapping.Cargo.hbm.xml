<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Cargo" table="Cargo">

    <id name="CargoUID">
      <column name="cargoUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="CargoSiape">
      <column name="cargoSiape" sql-type="int" not-null="true"/>
    </property>

    <property name="CargoGrupoSiape">
      <column name="cargoGrupoSiape" sql-type="int" not-null="true"/>
    </property>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="TipoSiape">
      <column name="tipoSiape" sql-type="int" not-null="true"/>
    </property>
    
  </class>

</hibernate-mapping>