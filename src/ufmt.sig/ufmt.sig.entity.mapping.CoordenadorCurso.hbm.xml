<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="CoordenadorCurso" table="CoordenadorCurso" mutable="false">

    <composite-id>
      
      <key-many-to-one name="Pessoa" lazy="false">
        <column name="pessoaUID" sql-type="bigint" not-null="true"/>
      </key-many-to-one>

      <key-many-to-one name="Curso" lazy="false">
        <column name="cursoUID" sql-type="bigint" not-null="true"/>
      </key-many-to-one>

      <key-property name="DataInicial">
        <column name="dataInicial" sql-type="date" not-null="true"/>
      </key-property>
      
    </composite-id>

    <property name="DataFinal">
      <column name="dataFinal" sql-type="date" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>