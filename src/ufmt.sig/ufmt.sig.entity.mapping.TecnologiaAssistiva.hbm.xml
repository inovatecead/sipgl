<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="TecnologiaAssistiva" table="TecnologiaAssistiva">

    <id name="TecnologiaAssistivaUID">
      <column name="tecnologiaAssistivaUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Curso" lazy="false">
      <column name="cursoUID" sql-type="bigint" not-null="true"/>
    </many-to-one>
    
    <many-to-one name="TipoTecnologiaAssistiva">
      <column name="tipoTecnologiaAssistivaUID" sql-type="char(3)" not-null="true"/>
    </many-to-one>
    
  </class>

</hibernate-mapping>