<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Afastamento" table="Afastamento">

    <id name="AfastamentoUID">
      <column name="afastamentoUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="Ano">
      <column name="ano" sql-type="int" not-null="true"/>
    </property>

    <property name="Periodo">
      <column name="periodo" sql-type="int" not-null="true"/>
    </property>
    
    <many-to-one name="Servidor" lazy="false">
      <column name="servidorUID" sql-type="bigint" not-null="true"/>
    </many-to-one>
    
    <property name="DataInicial">
      <column name="dataInicial" sql-type="date" not-null="false"/>
    </property>

    <property name="DataFinal">
      <column name="dataFinal" sql-type="date" not-null="false"/>
    </property>

    <property name="Justificativa">
      <column name="justificativa" sql-type="varchar(3072)" not-null="false"/>
    </property>

    <property name="DocumentoComprobatorio">
      <column name="documentoComprobatorio" sql-type="varchar(1024)" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>