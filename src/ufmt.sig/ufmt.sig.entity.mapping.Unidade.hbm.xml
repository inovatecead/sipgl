<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="Unidade" table="Unidade">

    <id name="UnidadeUID">
      <column name="unidadeUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="UnidadeSuperior" lazy="false">
      <column name="unidadeSuperiorUID" sql-type="bigint" not-null="false"/>
    </many-to-one>

    <many-to-one name="Campus" lazy="false">
      <column name="campusUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="Nome">
      <column name="nome" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="Sigla">
      <column name="sigla" sql-type="varchar(50)" not-null="false"/>
    </property>

    <property name="Hierarquia">
      <column name="hierarquia" sql-type="varchar(512)" not-null="false"/>
    </property>

    <property name="CodigoTipoUnidade">
      <column name="tipoUnidade" sql-type="int" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>