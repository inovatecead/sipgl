<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="OcorrenciaServidor" table="OcorrenciaServidor">

    <id name="OcorrenciaServidorUID">
      <column name="ocorrenciaServidorUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Servidor" lazy="false">
      <column name="servidorUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="TipoOcorrenciaServidor" lazy="false">
      <column name="tipoOcorrenciaServidorUID" sql-type="int" not-null="true"/>
    </many-to-one>

    <property name="Data">
      <column name="data" sql-type="date" not-null="true"/>
    </property>

    <property name="DiplomaLegalCodigo">
      <column name="diplomaLegalCodigo" sql-type="int" not-null="false"/>
    </property>

    <property name="DiplomaLegalNumero">
      <column name="diplomaLegalNumero" sql-type="varchar(15)" not-null="false"/>
    </property>
    
    <property name="DiplomaLegalData">
      <column name="diplomaLegalData" sql-type="date" not-null="false"/>
    </property>

    <property name="AfastamentoDataFinal">
      <column name="afastamentoDataFinal" sql-type="date" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>