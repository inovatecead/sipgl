<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="ResponsavelUnidade" table="ResponsavelUnidade">

    <id name="ResponsavelUnidadeUID">
      <column name="responsavelUnidadeUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <many-to-one name="Pessoa" lazy="false">
      <column name="pessoaUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <many-to-one name="Unidade" lazy="false">
      <column name="unidadeUID" sql-type="bigint" not-null="true"/>
    </many-to-one>

    <property name="DataInicial">
      <column name="dataInicial" sql-type="date" not-null="true"/>
    </property>

    <property name="DataFinal">
      <column name="dataFinal" sql-type="date" not-null="false"/>
    </property>

  </class>

</hibernate-mapping>