<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.progressaofuncional"
                   assembly="ufmt.sig" auto-import="false">

  <class name="ProgressaoFuncionalToItem" table="pFuncional.ProgressaoFuncionalToItem"  lazy="false">


    <id name="Id">
      <column name="Id" sql-type="int" not-null="true"/>
      <generator class="identity"/>
    </id>
    <many-to-one name="Item" lazy="false"   insert="false"  update="false">
      <column name="ItemId" sql-type="int" not-null="false"/>
    </many-to-one>


    <many-to-one name="ProgressaoFuncional" lazy="false"   insert="false"  update="false">
      <column name="ProgressaoFuncionalId" sql-type="int" not-null="false"/>
    </many-to-one>


    <bag name="ProgressaoFuncionalToItemToCampos"  lazy="true" inverse="true">
      <key column="ProgressaoFuncionalToItemId" />
      <one-to-many class="ProgressaoFuncionalToItemToCampos" />

    </bag>


    <property name="ItemId" >
      <column name="ItemId" sql-type="int" not-null="false"  />
    </property>
    <property name="ProgressaoFuncionalId" >
      <column name="ProgressaoFuncionalId" sql-type="int" not-null="false" />
    </property>
    <property name="status">
      <column name="status" sql-type="nchar(10)" not-null="false"/>
    </property>
    <property name="carga">
      <column name="carga" sql-type="int" not-null="false"/>
    </property>
    <property name="dataInicio">
      <column name="dataInicio" sql-type="datetime" not-null="false"/>
    </property>
    <property name="dataFim">
      <column name="dataFim" sql-type="datetime" not-null="false"/>
    </property>
  </class>

</hibernate-mapping>