<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="TipoEncargoServidor" table="TipoEncargoServidor">

    <id name="TipoEncargoServidorUID">
      <column name="TipoEncargoServidorUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="CategoriaEncargoUID">
      <column name="categoriaEncargoUID" sql-type="int" not-null="true"/>
    </property>

    <property name="CargaHoraria">
      <column name="cargaHoraria" sql-type="numeric(7,2)" not-null="false"/>
    </property>

    <property name="CargaHorariaFixa">
      <column name="cargaHorariaFixa" sql-type="bit" not-null="true"/>
    </property>

    <property name="ReducaoCargaHorariaEnsino">
      <column name="reducaoCargaHorariaEnsino" sql-type="numeric(7,2)" not-null="false"/>
    </property>

    <property name="RequerDetalhamento">
      <column name="requerDetalhamento" sql-type="bit" not-null="true"/>
    </property>

  </class>
</hibernate-mapping>