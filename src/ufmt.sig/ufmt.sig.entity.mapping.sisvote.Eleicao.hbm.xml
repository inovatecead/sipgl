<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity.sisvote"
                   assembly="ufmt.sig">

  <class name="Eleicao" table="sisvote.Eleicao">

    <id name="EleicaoUID">
      <column name="eleicaoUID" sql-type="bigint" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="DataHoraInicio">
      <column name="dataHoraInicio" sql-type="datetime" not-null="true"/>
    </property>

    <property name="DataHoraFim">
      <column name="dataHoraFim" sql-type="datetime" not-null="true"/>
    </property>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(255)" not-null="true"/>
    </property>

    <property name="CodigoSituacao">
      <column name="situacao" sql-type="int" not-null="true"/>
    </property>

  </class>

</hibernate-mapping>