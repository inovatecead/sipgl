<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   namespace="ufmt.sig.entity"
                   assembly="ufmt.sig">

  <class name="JornadaTrabalho" table="JornadaTrabalho">

    <id name="JornadaTrabalhoUID">
      <column name="jornadaTrabalhoUID" sql-type="int" not-null="true"/>
      <generator class="identity"/>
    </id>

    <property name="JornadaTrabalhoSiape">
      <column name="jornadaTrabalhoSiape" sql-type="int" not-null="true"/>
    </property>

    <property name="Descricao">
      <column name="descricao" sql-type="varchar(255)" not-null="true"/>
    </property>

  </class>

</hibernate-mapping>