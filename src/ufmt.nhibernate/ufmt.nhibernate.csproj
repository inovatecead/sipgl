      <HintPath>../../libs/NHibernate.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration"></Reference>
    <Reference Include="System.Web"></Reference>
    <Reference Include="System.Data"></Reference>
  </ItemGroup>
</Project>