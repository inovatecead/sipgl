<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Default.master.cs" Inherits="ufmt.sipgl.View.Default" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>SIPGL - Sistema de Pós-Graduação Lato Sensu</title>
    <link rel="Stylesheet" href="~/media/styles/style.css" type="text/css" />
    <link rel="Stylesheet" href="~/media/fontAwesome/css/all.css" type="text/css" />
    <link rel="Stylesheet" href="~/media/fontAwesome/css/brands.css" type="text/css" />
    <link rel="Stylesheet" href="~/media/fontAwesome/css/fontawesome.css" type="text/css" />
    <link rel="Stylesheet" href="~/media/fontAwesome/css/regular.css" type="text/css" />
    <link rel="Stylesheet" href="~/media/fontAwesome/css/solid.css" type="text/css" />
    <link rel="Stylesheet" href="~/media/fontAwesome/css/svg-with-js.css" type="text/css" />
    <link href="~/media/styles/redmond/jquery-ui-1.8.16.custom.css" rel="stylesheet" type="text/css" />
    <script src="../scripts/jquery-1.6.2.min.js" type="text/javascript"></script>
    <script src="../scripts/jquery-ui-1.8.16.custom.min.js" type="text/javascript"></script>
    <script src="../scripts/jquery.ui.datepicker-pt-BR.js" type="text/javascript"></script>

    <script type="text/javascript">

        $(document).ready(function () {

            $('.janelaSenha').dialog({
                autoOpen: false,
                width: 600,
                height: 250,
                modal: true,
                title: "Alterar Senha",
                draggable: true,
                resizable: false,
                open: function (type, data) {
                    $(this).parent().appendTo("form");
                }
            });

            $('.janelaRecuperarSenha').dialog({
                autoOpen: false,
                width: 600,
                height: 150,
                modal: true,
                title: "Recuperar Senha",
                draggable: true,
                resizable: false,
                open: function (type, data) {
                    $(this).parent().appendTo("form");
                }
            });
        });

        function func() {
            document.getElementById("typeMessage").style.display = "none";
        };

        window.onload = function () {
            setTimeout(func, 12000);
        };

        function showDialogMaster(id) {
            $('.' + id).dialog("open");
        }

        function closeDialogMaster(id) {
            $('.' + id).dialog("close");
        }


        $('.mestre').live('click', function () {
            $(this).siblings('.detalhes').toggle(500);
        });


    </script>

    <style type="text/css">
        .mestre {
            text-align: justify;
        }

        .detalhes {
            text-align: justify;
        }


        a.mestre:hover {
            font-weight: bold;
            font-size: 14px;
            COLOR: Black;
            text-decoration: underline;
        }

        a.mestre:link {
            color: Black;
            text-decoration: none;
            font-weight: normal;
            font-size: 14px;
            text-decoration: none;
        }

        a.mestre:visited {
            color: Black;
            text-decoration: none;
            font-weight: normal;
            font-size: 14px;
            text-decoration: none;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>


<body>
    <div class="page-container">
        <div class="content-wrap">
            <form id="form1" runat="server">
                <asp:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server" EnableScriptGlobalization="true" EnableScriptLocalization="true" AsyncPostBackTimeout="300">
                </asp:ToolkitScriptManager>
                <div id="total">

                    <%--<div>--%>

                    <div id="barra-brasil">
                        <div id="wrapper-barra-brasil">
                            <div class="brasil-flag"><a href="https://gov.br" class="link-barra">Brasil</a></div>
                            <nav>
                                <ul id="lista-barra-brasil" class="list">
                                    <li><a href="#" id="menu-icon"></a></li>
                                    <li class="list-item first"><a href="http://www.saude.gov.br/coronavirus" style="color: red;">CORONAVÍRUS (COVID-19)</a></li>
                                    <li class="list-item"><a href="http://www.simplifique.gov.br" class="link-barra">Simplifique!</a></li>
                                    <li class="list-item"><a href="https://www.gov.br/pt-br/participacao-social/" class="link-barra">Participe</a></li>
                                    <li class="list-item"><a href="http://www.acessoainformacao.gov.br" class="link-barra">Acesso à informação</a></li>
                                    <li class="list-item"><a href="http://www.planalto.gov.br/legislacao" class="link-barra">Legislação</a></li>
                                    <li class="list-item last last-item"><a href="https://gov.br/pt-br/canais-do-executivo-federal" class="link-barra">Canais</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>

                    <%--</div>--%>

                    <div id="gradient">
                        <div id="head-align">
                            <div id="head1">

                                <div class="ancoras">
                                    <a href="#contentBox" id="irparaconteudo" class="" title="Ir para o Conteúdo">Ir para o Conteúdo <span>1</span></a>
                                    <a href="#pnlMenu" id="irparamenu" class="" title="Ir para o Menu">Ir para o Menu <span>2</span></a>
                                    <a href="#buscar-campo" id="irparabusca" class="" title="Ir para a busca">Ir para a busca <span>3</span></a>
                                    <a href="#rodape" id="irpararodape" class="" title="Ir para o rodapé">Ir para o rodapé <span>4</span></a>
                                </div>

                                <div id="logo">
                                    <div class="logomg"></div>
                                    <div id="logotexto">
                                        <span>Universidade Federal de Mato Grosso</span>
                                        <h1>Sistema de Pós-Graduação Lato Sensu</h1>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="subMenuBarra">
                        <ul>
                            <li><a href="https://www.ufmt.br"><i class="fas fa-home"></i>&nbsp;Portal da UFMT</a></li>
                            <li><a href="/ufmt.avaliacaodesempenho/"><i class="fas fa-desktop"></i>&nbsp;Página Inicial</a></li>
                            <li><a href="https://ufmtonline.ufmt.br/home/details/course-v1:UFMT+CAD01+201X"><i class="fas fa-graduation-cap"></i>&nbsp;Curso SAD Online</a></li>
                        </ul>
                    </div>

                    <asp:Panel ID="pnlMenu" runat="server">
                        <div id="stylefour">
                            <ul>
                                <li id="MenuMinhasInscricoes" runat="server">
                                    <a href="<%=ResolveUrl("~") %>aluno/FrmListaInscricao.aspx" visible="false" title="" class="menuStyle">
                                        <asp:Image ID="imgMinhasInscricoes" runat="server" ImageUrl="~/media/images/btn-generico.png" AlternateText="Minhas Inscrições" />
                                        <br />
                                        <span>Minhas Inscrições</span>
                                    </a>
                                </li>

                                <li id="MenuPreMatricula" runat="server">
                                    <a href="<%=ResolveUrl("~") %>aluno/FrmListaCursosDisponiveis.aspx" visible="false" title="" class="menuStyle">
                                        <asp:Image ID="Image2" runat="server" ImageUrl="~/media/images/btn-generico.png" AlternateText="Pré-Inscrição" />
                                        <br />
                                        <span>Pré-Inscrição</span>
                                    </a>
                                </li>

                                <li id="MenuEditarCadastro" runat="server">
                                    <a href="<%=ResolveUrl("~") %>aluno/FrmAlteracaoPessoa.aspx" visible="false" title="" class="menuStyle">
                                        <asp:Image ID="imgEditarCadastro" runat="server" ImageUrl="~/media/images/btn-generico.png" AlternateText="Meu Cadastro" />
                                        <br />
                                        <span>Meu Cadastro</span>
                                    </a>
                                </li>

                                <!-- Logout -->
                                <li id="MenuSair" style="float: right; padding-right: 2%;" runat="server">
                                    <asp:HyperLink ID="lnkSair" runat="server" CssClass="menuStyle">
                                        <asp:Image ID="imgSair" runat="server" ImageUrl="~/media/images/logout-generico.png" />
                                        <br />
                                        <span>Sair</span>
                                    </asp:HyperLink>
                                </li>
                            </ul>

                            <div class="logadoComo" id="IdentificacaoUsuario" runat="server" style="padding-top: 17px;">
                                <asp:Label ID="logadoComo" runat="server" Text="Aluno: " />
                                <asp:Label ID="usuarioLogado" runat="server" />
                                <a href="<%=ResolveUrl("~/aluno/FrmAlterarSenha.aspx") %>" title="Alteração de Senha">[ Alterar Senha ]</a>
                            </div>
                        </div>

                    </asp:Panel>



                    <asp:Panel ID="typeMessage" runat="server">
                        <asp:Label ID="textMessage" runat="server"></asp:Label>
                    </asp:Panel>

                    <asp:Panel runat="server">
                    </asp:Panel>

                    <div id="floatBox">
                        <div id="contentBox">
                            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div id="rodape" class="footer-align-login">
            <div class="footer-animado-login">
                <img src="../media/images/rodape_animado.gif" alt="Imagem animada, viola de coxo e Tuiuiú" />
            </div>

            <div>
                Universidade Federal de Mato Grosso - UFMT<br />
                Secretaria de Tecnologia da Informação - STI<br />
                Av. Fernando Correa da Costa, nº 2367 - Bairro Boa Esperança. Cuiabá - MT - 78060-900
            </div>

            <div>Fone: +55 (65) 3615-6283</div>

            <div class="footer-bar">
                Contato: <a href="mailto:apoio@ufmt.br">apoio@ufmt.br</a>
            </div>
        </div>
    </div>

    <script async src="https://barra.brasil.gov.br/barra.js" type="text/javascript"></script>
	<script src="Scripts/jquery-1.6.2.min.js" type="text/javascript"></script>
	<script src="Scripts/acessibilidade.js" type="text/javascript"></script>
</body>
</html>
